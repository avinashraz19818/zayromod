NODE_ENV=production
HOST=127.0.0.1
PORT=3100
TRUST_PROXY_HOPS=1
BASE_URL=https://app.mizammod.site
ADMIN_ORIGIN=https://admin.mizammod.site
SESSION_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
CONTENT_ENCRYPTION_PASSWORD=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# Numeric Telegram IDs allowed to approve credit requests from bot callbacks.
TELEGRAM_APPROVER_IDS=
# Empty denies every client. Comma-separated numeric IDs, or explicit * for all Telegram users.
TELEGRAM_ALLOWED_IDS=
# Keep false during staging to avoid two pollers on the same bot.
BOT_POLLING_ENABLED=false
ANDROID_HOME=/opt/mizanmods-android-sdk
JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
KEYSTORE_PATH=/var/lib/mizanmods/secrets/mizanmods-release.p12
KEYSTORE_ALIAS=mizanmods
KEYSTORE_PASSWORD=
KEY_PASSWORD=
APK_BUILD_VARIANT=protectedRelease
APK_BUILD_TIMEOUT_MS=900000
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_URL=
FIREBASE_WEB_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
