# Generate a unique token: openssl rand -hex 32. Never use an existing client's token.
ADMIN_TOKEN=
PORT=3000
# Must be unique to this installation; never point at another application's data.
DATA_DIR=./runtime
ANDROID_HOME=/opt/android-sdk
BUILD_TOOLS_VERSION=35.0.0
BUILD_TIMEOUT_MS=900000
MAX_QUEUE=10
RETENTION_DAYS=7
# Absolute path to a new MizanMods signing key, kept outside source control.
KEYSTORE_PATH=
KEYSTORE_ALIAS=mizanmods
KEYSTORE_PASSWORD=
KEY_PASSWORD=
