{
  "name": "mizanmods",
  "version": "1.0.0",
  "private": true,
  "description": "Independent Android build studio",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node --test tests/*.test.js",
    "doctor": "node --env-file-if-exists=.env scripts/doctor.js",
    "export": "node scripts/export.js",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "express": "5.1.0",
    "express-rate-limit": "8.7.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  }
}
