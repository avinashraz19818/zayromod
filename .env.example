PORT=3000
SESSION_SECRET=change_this_to_random_string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_ADMIN_CHAT_ID=your_chat_id_here
BASE_URL=https://yourdomain.com
# ── Google OAuth Login (optional) ──
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client
# (Web application) se milta hai. Redirect URI: BASE_URL + /auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# ── Firebase service account (hack lock) ──
# Firebase Console → Project settings → Service accounts → Generate new
# private key → JSON file VPS pe rakho → yahan path do.
GOOGLE_APPLICATION_CREDENTIALS=
# ── Restore scripts ka secret (rules lagne ke baad) ──
# Koi bhi random value rakho — scripts (hunt-full-urls etc.) isi se
# server ke /api/admin/firebase/restore-link endpoint pe kaam karti hain.
RESTORE_SECRET=
# ── Frezrik Jiagu (DEFAULT — open-source DEX packer, koi account nahi) ──
# bash scripts/setup-frezrik.sh chalao (auto-download). Ye har build me
# DEX AES-encrypt karta hai — decompile pe sirf shell dikhta hai.
# FREZRIK_ENABLED=false karo to band ho jata hai (normal build).
FREZRIK_ENABLED=true
FREZRIK_JAR=/opt/frezrik/pack.jar
FREZRIK_ALIAS=zayro
# ── 360 Jiagu hardening (optional — account wala, backup option) ──
# jiagu.360.cn se account banao + jiagu.jar download karo. JIAGU_ENABLED=true
# karne pe har build 360 hardening + autosign se guzarta hai (fail ho to
# normal signing fallback).
JIAGU_ENABLED=false
JIAGU_JAR=/opt/jiagu/jiagu.jar
JIAGU_EMAIL=
JIAGU_PASS=
