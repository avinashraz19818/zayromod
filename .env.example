# Runtime
NODE_ENV=production
PORT=3000
BASE_URL=https://yourdomain.com
# Set to the number of trusted reverse proxies in front of this process.
# Use 0 when the app is directly exposed; use 1 for one trusted Nginx/Load Balancer.
TRUST_PROXY_HOPS=1

# Authentication secrets — generate unique values; never commit the real .env
SESSION_SECRET=replace_with_at_least_32_random_characters
SESSION_TTL_MINUTES=480
SESSION_IDLE_TIMEOUT_MINUTES=30
BCRYPT_ROUNDS=12

# Admin login. Production requires ADMIN_PASSWORD_HASH (bcrypt), not a default
# or plaintext password. Generate one offline with bcryptjs/bcrypt.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# ADMIN_PASSWORD is intentionally unsupported; use a bcrypt hash above.

# Transactional email (required for password registration, verification and reset)
RESEND_API_KEY=
EMAIL_FROM=Zayro Mod Builder <noreply@yourdomain.com>
EMAIL_REPLY_TO=
EMAIL_VERIFICATION_TTL_MINUTES=30
PASSWORD_RESET_TTL_MINUTES=30

# Telegram authentication/bot notifications. The bot token may also be entered
# in the admin settings page; it is write-only there and is never returned.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Google OAuth Login (optional)
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client
# (Web application). Redirect URI must be BASE_URL + /auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Firebase service account (server-only; keep the JSON outside the repository)
# Firebase Console → Project settings → Service accounts → Generate new key.
GOOGLE_APPLICATION_CREDENTIALS=/root/firebase/service-account.json

# Restore scripts' server-only secret. Do not send it from browser JavaScript.
RESTORE_SECRET=

# Frezrik Jiagu (open-source DEX packer, optional)
FREZRIK_ENABLED=true
FREZRIK_JAR=/opt/frezrik/pack.jar
FREZRIK_ALIAS=zayro

# 360 Jiagu hardening (optional; account credentials stay server-only)
JIAGU_ENABLED=false
JIAGU_JAR=/opt/jiagu/jiagu.jar
JIAGU_EMAIL=
JIAGU_PASS=

# Other existing build/runtime secrets are configured here when used:
# KEYSTORE_PASSWORD=
# KEYSTORE_ALIAS=zayro
# CONTENT_ENCRYPTION_PASSWORD=
# FIREBASE_WEB_API_KEY=
